# Release signing for Belknap Tracker. Copy to `keystore.properties` (gitignored)
# and fill in for LOCAL release builds. CI writes this file from repo secrets.
#
# storeFile may be an absolute path or relative to the android/ directory.
# Keep the .jks file OUTSIDE the repo and back it up - it is the one
# irreplaceable artifact (see docs/adr/001-private-release-distribution.md).
storeFile=/absolute/path/to/belknap-release.jks
storePassword=CHANGE_ME
keyAlias=belknap
keyPassword=CHANGE_ME
